  {
   "id": "nc-06-human-prompt-then-confirm-records",
   "guard": "notify-check",
   "given": {
    "repo": {
     "project_json": {
      "branch_flow": {
       "feature_prefix": "feature/",
       "integration": "main",
       "production": "main"
      },
      "notifications": {
       "channel": "google-chat",
       "target": "spaces/AAAAQCj0Cjc",
       "via": "cli",
       "events": [
        "qa",
        "deploy"
       ]
      }
     },
     "spec": {
      "feat-a": {
       "change_id": "feat-a",
       "phase": "impl"
      }
     }
    },
    "setup": "printf '%s' '{\"session_id\": \"s\", \"transcript_path\": \"\", \"cwd\": \"{{root}}\", \"hook_event_name\": \"UserPromptSubmit\", \"prompt\": \"confirmo notificacion de54d3c8\"}' | CLAUDE_PROJECT_DIR={{root}} bash {{plugin}}/hooks/karvey-hook.sh prompt >/dev/null"
   },
   "input": {},
   "event": "prompt",
   "command": "python3 {{plugin}}/scripts/karvey-config.py notify-check --confirm --root {{root}}; echo \"rc=$?\"",
   "expect": {
    "decision": "allow",
    "stdout_contains": [
     "destination confirmed and recorded",
     "rc=0"
    ],
    "files_exist": "{{repo}}/karvey/notify-last.json",
    "file_contains": {
     "{{repo}}/karvey/approvals/notify/confirm-cdb4ee2aea69cc6a.json": "\"consumed_at\": \"20"
    }
   },
   "tags": [
    "notify-confirm",
    "D-16",
    "REQ-W1-097"
   ]
  },
