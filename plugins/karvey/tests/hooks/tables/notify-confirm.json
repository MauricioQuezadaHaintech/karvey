{
 "table": "notify-confirm",
 "description": "D-16 / F-15 (REQ-W1-097): a changed notification destination is confirmed only by the human. The UserPromptSubmit hook records 'confirmo notificacion <code>' (code = first 8 hex of the destination hash) as a marker scoped to the clone, the project and that destination, with the approval-marker TTL; karvey-config.py notify-check --confirm records the destination only against a live matching marker (single use); protect-paths blocks the agent from writing the marker or the notify record.",
 "cases": [
  {
   "id": "nc-01-human-phrase-records-the-confirmation",
   "guard": "approval",
   "given": {
    "repo": {
     "project_json": {
      "branch_flow": {
       "feature_prefix": "feature/",
       "integration": "main",
       "production": "main"
      },
      "notifications": {
       "channel": "google-chat",
       "target": "spaces/AAAAQCj0Cjc",
       "via": "cli",
       "events": [
        "qa",
        "deploy"
       ]
      }
     },
     "spec": {
      "feat-a": {
       "change_id": "feat-a",
       "phase": "impl"
      }
     }
    }
   },
   "input": {
    "prompt": "confirmo notificación de54d3c8"
   },
   "expect": {
    "decision": "allow",
    "stdout_contains": "[karvey] notification destination confirmation recorded (de54d3c8, expires ",
    "files_exist": "{{repo}}/karvey/approvals/notify/confirm-cdb4ee2aea69cc6a.json",
    "file_contains": {
     "{{repo}}/karvey/approvals/notify/confirm-cdb4ee2aea69cc6a.json": [
      "\"kind\": \"notify\"",
      "\"code\": \"de54d3c8\"",
      "\"project\": \".\"",
      "\"ttl_min\": 120"
     ]
    }
   },
   "expect_nopy": {
    "decision": "allow",
    "stdout_empty": true,
    "files_absent": "{{repo}}/karvey/approvals/notify/confirm-cdb4ee2aea69cc6a.json"
   },
   "tags": [
    "notify-confirm",
    "D-16",
    "REQ-W1-097",
    "nopy"
   ]
  },
