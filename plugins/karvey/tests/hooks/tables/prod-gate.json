{
 "table": "prod-gate",
 "description": "E1.F5.T5/T6 / REQ-W1-023..027, 035 (H-12, H-15): the prod-gate is ON by default (D-02); a merge into the production set (branch_flow.production ∪ origin/HEAD ∪ master/main, minus integration) needs the human prod approval of the released change in the release ledger (D-03); it fails closed.",
 "cases": [
  {
   "id": "pg1-01-gh-merge-admin-no-approval",
   "guard": "prod-gate",
   "given": {
    "repo": {
     "default_branch": "main",
     "remote_branches": [
      "dev"
     ],
     "branch": "feature/feat-a",
     "project_json": {
      "branch_flow": {
       "feature_prefix": "feature/",
       "integration": "dev",
       "production": "main"
      }
     },
     "spec": {
      "feat-a": {
       "change_id": "feat-a",
       "phase": "deploying"
      }
     }
    },
    "stubs": {
     "gh": {
      "stdout": {
       "baseRefName": "main",
       "headRefName": "feature/feat-a",
       "title": "Deploy",
       "number": 12
      }
     }
    }
   },
   "input": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "gh pr merge 12 --merge --admin"
    }
   },
   "expect": {
    "decision": "block",
    "stderr_contains": [
     "[karvey] prod-gate BLOCK",
     "change=feat-a",
     "missing=by,role,ref"
    ]
   },
   "tags": [
    "prod-gate",
    "H-12",
    "REQ-W1-023"
   ]
  },
  {
