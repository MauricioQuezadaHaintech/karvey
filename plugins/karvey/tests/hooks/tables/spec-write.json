{
 "table": "spec-write",
 "description": "E1.F5.T7 / REQ-W1-028, 063: PostToolUse on Edit/Write. A written docs/spec/**/spec.json or docs/spec/project.json is validated in-process (exit 2 with the violations on stderr, A-4); every docs/spec/** write is appended to docs/spec/.graph-pending (sorted, deduped, LF), never the pending file itself or graphify-out/**.",
 "cases": [
  {
   "id": "sw-01-valid-spec-silent",
   "guard": "spec-write",
   "event": "post-edit",
   "given": {
    "repo": {
     "project_json": {
      "git_platform": "github",
      "repos": [
       "repo"
      ],
      "spec_repo": "repo",
      "branch_flow": {
       "feature_prefix": "feature/",
       "integration": "main",
       "production": "main"
      }
     },
     "spec": {
      "feat-a": {
       "change_id": "feat-a",
       "phase": "impl"
      }
     },
     "wc_files": {
      "docs/spec/changes/feat-a/spec.json": {
       "change_id": "feat-a",
       "phase": "tasks"
      }
     }
    }
   },
   "input": {
    "tool_name": "Write",
    "tool_input": {
     "file_path": "{{root}}/docs/spec/changes/feat-a/spec.json",
     "content": "…"
    }
   },
   "expect": {
    "decision": "allow",
    "stderr_empty": true,
    "stdout_empty": true,
    "file_contains": {
     "{{root}}/docs/spec/.graph-pending": "docs/spec/changes/feat-a/spec.json"
    }
   },
   "tags": [
    "spec-write",
    "REQ-W1-028",
    "REQ-W1-063"
   ]
  },
