{
  "table": "statusline",
  "description": "Statusline (E1.F11.T1): visible invalid zone (BUG-08, REQ-W1-100), windows joined with ' · ' (BUG-09, REQ-W1-101), rotation default read from defaults.json and 'rot?' when it cannot be found (REQ-W1-049, D-06), context lights by percent of the window with the token pair as fallback (D-18). The script always exits 0, so every decision is allow.",
  "cases": [
    {
      "id": "statusline-01-valid-tz-no-marker",
      "guard": "statusline",
      "event": "statusline",
      "given": {"env": {"KARVEY_TZ": "America/Santiago"}},
      "input": {"stdin": {"rate_limits": {"five_hour": {"used_percentage": 10, "resets_at": "{{now+90m}}"}}}},
      "expect": {"decision": "allow", "stdout_contains": ["limit 5h 10% ↻", "(1h30m)"],
                 "stdout_not_contains": ["(TZ?)", "statusline down"]},
      "tags": ["statusline", "BUG-08", "REQ-W1-100"]
    },
    {
      "id": "statusline-02-invalid-tz-marked",
      "guard": "statusline",
      "event": "statusline",
      "given": {"env": {"KARVEY_TZ": "Mars/Olympus"}},
      "input": {"stdin": {"rate_limits": {"five_hour": {"used_percentage": 10, "resets_at": "{{now+90m}}"},
                                          "seven_day": {"used_percentage": 29, "resets_at": "{{now+26h}}"}}}},
      "expect": {"decision": "allow", "stdout_contains": ["(TZ?) (1h30m)", "(TZ?) (1d2h)"],
                 "stdout_not_contains": "statusline down"},
      "tags": ["statusline", "BUG-08", "REQ-W1-100"]
    },
    {
      "id": "statusline-03-no-tz-no-marker",
      "guard": "statusline",
      "event": "statusline",
      "given": {},
      "input": {"stdin": {"rate_limits": {"five_hour": {"used_percentage": 10, "resets_at": "{{now+90m}}"}}}},
      "expect": {"decision": "allow", "stdout_contains": "limit 5h 10% ↻", "stdout_not_contains": "(TZ?)"},
      "tags": ["statusline", "BUG-08", "REQ-W1-100"]
    },
    {
      "id": "statusline-04-only-7d-no-leading-separator",
      "guard": "statusline",
      "event": "statusline",
      "given": {},
      "input": {"stdin": {"rate_limits": {"seven_day": {"used_percentage": 29}}}},
      "expect": {"decision": "allow", "stdout_contains": "limit 7d 29%", "stdout_not_contains": "limit ·"},
      "tags": ["statusline", "BUG-09", "REQ-W1-101"]
    },
    {
      "id": "statusline-05-both-windows-one-separator",
      "guard": "statusline",
      "event": "statusline",
      "given": {},
      "input": {"stdin": {"rate_limits": {"five_hour": {"used_percentage": 10},
                                          "seven_day": {"used_percentage": 29}}}},
      "expect": {"decision": "allow", "stdout_contains": "limit 5h 10% · 7d 29%",
                 "stdout_not_contains": ["limit ·", "· ·"]},
      "tags": ["statusline", "BUG-09", "REQ-W1-101"]
    },
    {
      "id": "statusline-06-only-5h",
      "guard": "statusline",
      "event": "statusline",
      "given": {},
      "input": {"stdin": {"rate_limits": {"five_hour": {"used_percentage": 10}}}},
      "expect": {"decision": "allow", "stdout_contains": "limit 5h 10%", "stdout_not_contains": ["7d", "limit ·"]},
      "tags": ["statusline", "BUG-09", "REQ-W1-101"]
    },
    {
      "id": "statusline-07-rotation-default-from-defaults-json",
      "guard": "statusline",
      "event": "statusline",
      "note": "9 h > defaults.json:rotation_hours (8, D-06) with KARVEY_ROTATE_HOURS unset: the hours rule fires.",
      "given": {},
      "input": {"stdin": {"cost": {"total_duration_ms": 32400000}}},
      "expect": {"decision": "allow", "stdout_contains": ["9.0h", "TIME TO ROTATE (hours)"],
                 "stdout_not_contains": "rot?"},
      "tags": ["statusline", "REQ-W1-049", "D-06"]
    },
    {
      "id": "statusline-08-rotation-unknown-when-defaults-missing",
      "guard": "statusline",
      "event": "statusline",
      "note": "A copy of the script outside the plugin cannot find defaults.json: it shows rot? instead of a second literal.",
      "given": {"script_copy": true},
      "input": {"stdin": {"cost": {"total_duration_ms": 32400000}}},
      "expect": {"decision": "allow", "stdout_contains": "9.0h rot?",
                 "stdout_not_contains": ["TIME TO ROTATE", "statusline down"]},
      "tags": ["statusline", "REQ-W1-049", "D-06"]
    },
    {"id": "statusline-09-ctx-below-yellow-pct-green", "guard": "statusline", "event": "statusline", "note": "29 % of a 1M window (290k, over the old 150k token red): green, no warning (D-18).", "given": {}, "input": {"stdin": {"context_window": {"current_usage": {"cache_read_input_tokens": 290000}, "used_percentage": 29, "context_window_size": 1000000}}}, "expect": {"decision": "allow", "stdout_contains": "🟢 ctx 290k (29%)", "stdout_not_contains": ["TIME TO ROTATE", "statusline down"]}, "tags": ["statusline", "D-18", "REQ-W1-049"]},
    {"id": "statusline-10-ctx-yellow-at-30-pct", "guard": "statusline", "event": "statusline", "note": "30 % = defaults.json:context_pct.yellow: amber, no warning yet.", "given": {}, "input": {"stdin": {"context_window": {"current_usage": {"cache_read_input_tokens": 300000}, "used_percentage": 30, "context_window_size": 1000000}}}, "expect": {"decision": "allow", "stdout_contains": "🟡 ctx 300k (30%)", "stdout_not_contains": "TIME TO ROTATE"}, "tags": ["statusline", "D-18", "REQ-W1-049"]},
    {"id": "statusline-11-ctx-red-at-50-pct", "guard": "statusline", "event": "statusline", "note": "50 % = defaults.json:context_pct.red: red and TIME TO ROTATE (context).", "given": {}, "input": {"stdin": {"context_window": {"current_usage": {"cache_read_input_tokens": 500000}, "used_percentage": 50, "context_window_size": 1000000}}}, "expect": {"decision": "allow", "stdout_contains": ["🔴 ctx 500k (50%)", "TIME TO ROTATE (context)"]}, "tags": ["statusline", "D-18", "REQ-W1-049"]},
    {"id": "statusline-12-pct-computed-from-window-size", "guard": "statusline", "event": "statusline", "note": "No used_percentage: 100k of a 200k window is computed as 50 % and turns red.", "given": {}, "input": {"stdin": {"context_window": {"current_usage": {"cache_read_input_tokens": 100000}, "context_window_size": 200000}}}, "expect": {"decision": "allow", "stdout_contains": ["🔴 ctx 100k (50%)", "TIME TO ROTATE (context)"]}, "tags": ["statusline", "D-18", "REQ-W1-049"]},
    {"id": "statusline-13-token-fallback-without-window", "guard": "statusline", "event": "statusline", "note": "Neither percentage nor window size: the context_tokens pair decides (160k >= red).", "given": {}, "input": {"stdin": {"context_window": {"current_usage": {"cache_read_input_tokens": 160000}}}}, "expect": {"decision": "allow", "stdout_contains": ["🔴 ctx 160k", "TIME TO ROTATE (context)"], "stdout_not_contains": "%)"}, "tags": ["statusline", "D-18", "REQ-W1-049"]},
    {"id": "statusline-14-pct-env-override", "guard": "statusline", "event": "statusline", "note": "KARVEY_ROTATE_CTX_RED_PCT=90 wins over defaults.json: 60 % stays amber.", "given": {"env": {"KARVEY_ROTATE_CTX_RED_PCT": "90"}}, "input": {"stdin": {"context_window": {"current_usage": {"cache_read_input_tokens": 600000}, "used_percentage": 60, "context_window_size": 1000000}}}, "expect": {"decision": "allow", "stdout_contains": "🟡 ctx 600k (60%)", "stdout_not_contains": "TIME TO ROTATE"}, "tags": ["statusline", "D-18", "REQ-W1-049"]},
    {"id": "sl-fail-01-unreadable-stdin-shows-down-line", "guard": "statusline", "event": "statusline", "note": "wave2 E1.F12.T3 / REQ-W2-082 (F-33): a stdin the script cannot read (a JSON list) must not make the statusline vanish: it prints the failure line with the exit code, the reason and where the last stdin was kept.", "given": {}, "input": {"stdin": [1, 2]}, "expect": {"decision": "allow", "stdout_contains": ["karvey statusline down (rc=", ".karvey-statusline-last."], "stdout_not_contains": "TIME TO ROTATE"}, "tags": ["statusline", "REQ-W2-082", "F-33"]},
    {"id": "sl-cost-01-capture-written-outside-the-tree", "guard": "statusline", "event": "statusline", "note": "wave3 E1.F3.T2 / REQ-W3-015: with cost.total_cost_usd inside a Karvey project the statusline writes the capture to the machine-local state dir (session id hashed), the repository tree stays unchanged and the line still shows the cost.", "given": {"repo": {"branch": "feature/demo", "project_json": {"name": "demo", "notifications": {"channel": "none"}, "management": {"tool": "markdown"}}, "spec": {"demo": {"change_id": "demo", "phase": "requirements"}}}}, "input": {"stdin": {"session_id": "sess-demo-1", "cost": {"total_cost_usd": 1.5}, "context_window": {"current_usage": 20000, "context_window_size": 200000}, "cwd": "{{root}}"}}, "expect": {"decision": "allow", "stdout_contains": ["US$1.50"], "stdout_not_contains": "statusline down", "files_exist": "{{repo}}/karvey/cost/16c1f6a3d4ba4a08.json", "file_contains": {"{{repo}}/karvey/cost/16c1f6a3d4ba4a08.json": ["\"usd\": 1.5", "\"root_key\"", "\"context_pct\": 10.0", "\"at\""]}, "file_not_contains": {"{{repo}}/karvey/cost/16c1f6a3d4ba4a08.json": "sess-demo-1"}, "tree_clean": true}, "tags": ["statusline", "REQ-W3-015"]},
    {"id": "sl-cost-02-no-cost-no-capture", "guard": "statusline", "event": "statusline", "note": "wave3 E1.F3.T2 / REQ-W3-015: without a cost figure nothing is captured and the statusline output is the usual one.", "given": {"repo": {"branch": "feature/demo", "project_json": {"name": "demo", "notifications": {"channel": "none"}, "management": {"tool": "markdown"}}, "spec": {"demo": {"change_id": "demo", "phase": "requirements"}}}}, "input": {"stdin": {"session_id": "sess-demo-1", "context_window": {"current_usage": 20000, "context_window_size": 200000}, "cwd": "{{root}}"}}, "expect": {"decision": "allow", "stdout_contains": ["ctx 20k (10%)"], "stdout_not_contains": ["US$", "statusline down"], "files_absent": "{{repo}}/karvey/cost/16c1f6a3d4ba4a08.json", "tree_clean": true}, "tags": ["statusline", "REQ-W3-015"]}
  ]
}
