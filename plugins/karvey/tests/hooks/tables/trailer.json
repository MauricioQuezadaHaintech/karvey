{
 "table": "trailer",
 "description": "wave2-structural E1.F5.T4 / REQ-W2-044: with enforcement.trailer_guard warn or blocking, a git commit on {feature_prefix}{id} of an active change must carry Karvey-Change: {id}; the message is read from -m, -F and --trailer; an editor commit and a branch of no active change are silent; off (the default) is silent.",
 "cases": [
  {
   "id": "tr-01-off-by-default-silent",
   "guard": "trailer",
   "given": {
    "repo": {
     "branch": "feature/feat-a",
     "project_json": {
      "branch_flow": {
       "feature_prefix": "feature/",
       "integration": "main",
       "production": "main"
      }
     },
     "spec": {
      "feat-a": {
       "change_id": "feat-a",
       "phase": "impl"
      }
     }
    }
   },
   "input": {
    "tool_name": "Bash",
    "tool_input": {
     "command": "git commit -m 'feat: x'"
    }
   },
   "expect": {
    "decision": "allow",
    "stdout_empty": true,
    "stderr_empty": true
   },
   "tags": [
    "trailer",
    "REQ-W2-044"
   ]
  },
  {
