{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "karvey:project.schema.json",
  "$comment": "Architecture §2.6 (wave1-hardening). x-karvey-safe names the safe_values kind that checks the value before it reaches a command (§3.1).",
  "x-karvey-schema-version": 1,
  "type": "object",
  "required": [
    "git_platform",
    "repos",
    "spec_repo",
    "branch_flow"
  ],
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "string"
    },
    "git_platform": {
      "enum": [
        "github",
        "azure_devops",
        "gitlab"
      ]
    },
    "cloud": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "azure",
            "gcp",
            "aws",
            "mixed",
            "none"
          ]
        }
      }
    },
    "iac_tool": {
      "enum": [
        "terraform",
        "bicep",
        "pulumi",
        "none"
      ]
    },
    "knowledge_sync": {
      "enum": [
        "none",
        "graphify",
        "obsidian"
      ],
      "x-karvey-default": "none"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spec_repo": {
      "type": "string",
      "minLength": 1
    },
    "ops_repo": {
      "type": "string"
    },
    "branch_flow": {
      "type": "object",
      "required": [
        "integration",
        "production"
      ],
      "properties": {
        "feature_prefix": {
          "$ref": "#/$defs/refPrefix"
        },
        "integration": {
          "$ref": "#/$defs/branchName"
        },
        "production": {
          "$ref": "#/$defs/branchName"
        },
        "protected_branches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/*-]{1,100}$"
          }
        },
        "mode": {
          "enum": [
            "trunk",
            "env-branches"
          ],
          "x-karvey-note": "derived: trunk when integration = production (wave2-structural §1.11)"
        }
      }
    },
    "standards": {
      "type": "object"
    },
    "enforcement": {
      "type": "object",
      "properties": {
        "git_flow_hook": {
          "type": "boolean"
        },
        "plan_gate_hook": {
          "type": "boolean"
        },
        "prod_gate_hook": {
          "type": "boolean",
          "x-karvey-default": true
        },
        "plan_marker_ttl_min": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440,
          "x-karvey-default": 120
        },
        "approval_vocabulary": {
          "type": "object",
          "properties": {
            "approve": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "negate": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "prod_terms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "trailer_guard": {
          "enum": [
            "off",
            "warn",
            "blocking"
          ],
          "x-karvey-default": "off"
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "google-chat",
            "slack",
            "teams",
            "email",
            "webhook",
            "none",
            "google_chat"
          ]
        },
        "target": {
          "type": "string",
          "x-karvey-safe": "notifications.target"
        },
        "via": {
          "enum": [
            "mcp",
            "cli",
            "webhook",
            "api",
            ""
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "qa",
              "deploy",
              "incident",
              "approval_requested",
              "awaiting_human",
              "blocked"
            ]
          }
        },
        "detail": {
          "enum": [
            "counts",
            "full"
          ],
          "x-karvey-default": "counts"
        },
        "deferred": {
          "type": "boolean",
          "x-karvey-note": "'not now' at init (REQ-W1-095)"
        },
        "qa_every_run": {
          "type": "boolean",
          "x-karvey-note": "notify qa on every run, not only on the first run and a verdict change (wave3 §1.15)"
        }
      }
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "x-karvey-note": "the client this project serves; every new change inherits it (wave3 §1.20, REQ-W3-044)"
    },
    "time_zone": {
      "type": "string",
      "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z0-9_+-]+){1,2})$",
      "x-karvey-note": "the project's IANA time zone (Area/City) for dates in the changelog and reports; absent → the environment's (wave3 §1.22, REQ-W3-056)"
    },
    "browse": {
      "type": "object",
      "properties": {
        "via": {
          "type": "string",
          "pattern": "^(local|none|agent:[A-Za-z0-9][A-Za-z0-9._-]{0,63})$",
          "x-karvey-note": "where browser work runs: local (default), agent:<name> (a self-contained instruction to another agent), none (visual checks not evaluated) — wave3 §1.22, REQ-W3-054"
        }
      }
    },
    "backlog": {
      "type": "object",
      "properties": {
        "refine_days": {
          "type": "integer",
          "minimum": 1,
          "x-karvey-note": "backlog refinement cadence in days (default 14); the dashboard flags it overdue (wave3 §1.21, REQ-W3-052)"
        }
      }
    },
    "stakeholders": {
      "$ref": "#/$defs/stakeholders"
    },
    "leak": {
      "type": "object",
      "properties": {
        "deny_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        }
      },
      "x-karvey-note": "terms that must never appear on a sponsor page (other clients' names without a portfolio file, F-72)"
    },
    "management": {
      "oneOf": [
        {
          "$ref": "karvey:spec.schema.json#/$defs/toolName",
          "x-karvey-severity": "warning",
          "x-karvey-note": "legacy string → --fix"
        },
        {
          "type": "object",
          "required": [
            "tool"
          ],
          "properties": {
            "tool": {
              "$ref": "karvey:spec.schema.json#/$defs/toolName"
            },
            "location": {
              "type": "string",
              "x-karvey-safe": "management.location"
            },
            "statuses": {
              "$ref": "#/$defs/statuses"
            },
            "hierarchy": {
              "type": "string"
            },
            "via": {
              "enum": [
                "mcp",
                "cli",
                "api",
                "file"
              ]
            },
            "sprints": {
              "type": "string",
              "x-karvey-safe": "management.sprints"
            }
          }
        }
      ]
    },
    "wip_limit": {
      "type": "integer",
      "minimum": 1
    },
    "stall_days": {
      "type": "integer",
      "minimum": 1,
      "x-karvey-default": 7
    },
    "calibration": {
      "type": "object",
      "properties": {
        "threshold_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "x-karvey-default": 30
        },
        "window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "x-karvey-default": 3
        }
      }
    },
    "schema_mode": {
      "enum": [
        "advisory",
        "strict"
      ],
      "x-karvey-default": "advisory"
    },
    "gates": {
      "enum": [
        "granular",
        "merged"
      ],
      "x-karvey-note": "absent = the check-mode registry default (gates.merged)"
    },
    "judges": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "advisory",
            "blocking"
          ]
        },
        "phases": {
          "type": "array",
          "items": {
            "enum": [
              "requirements",
              "mockup",
              "design_graphic",
              "architecture",
              "infra",
              "tasks",
              "qa"
            ]
          }
        },
        "lenses": {
          "type": "object"
        },
        "per_lane": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cross_model": {
          "enum": [
            "prefer",
            "never"
          ]
        },
        "budget": {
          "x-karvey-note": "ignored: measure only (D-30); karvey-state.py validate reports it as cost.cap_key, a warning in every mode, never an error (wave3-optimization §1.9, F-62)"
        }
      }
    },
    "lanes": {
      "type": "object",
      "properties": {
        "globs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./*{},-]{1,200}$"
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "off",
          "advisory",
          "warn",
          "blocking",
          "granular",
          "merged"
        ]
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./*{},-]{1,200}$"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object"
        }
      }
    },
    "karvey_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "docs_pr": {
      "type": "object"
    },
    "clickup": {
      "type": "object",
      "x-karvey-severity": "warning",
      "x-karvey-note": "legacy top-level block"
    }
  },
  "$defs": {
    "branchName": {
      "type": "string",
      "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,100}(?<!\\.lock)(?<!/)$"
    },
    "refPrefix": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,40}/$"
    },
    "statusName": {
      "oneOf": [
        {
          "type": "string",
          "x-karvey-safe": "status"
        },
        {
          "type": "null"
        }
      ]
    },
    "flatStatuses": {
      "type": "object",
      "properties": {
        "todo": {
          "$ref": "#/$defs/statusName"
        },
        "in_progress": {
          "$ref": "#/$defs/statusName"
        },
        "review": {
          "$ref": "#/$defs/statusName"
        },
        "done": {
          "$ref": "#/$defs/statusName"
        },
        "blocked": {
          "$ref": "#/$defs/statusName"
        }
      },
      "additionalProperties": false
    },
    "statuses": {
      "anyOf": [
        {
          "$ref": "#/$defs/flatStatuses"
        },
        {
          "type": "object",
          "properties": {
            "by_level": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/flatStatuses"
              }
            },
            "by_list": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/flatStatuses"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "stakeholder": {
      "type": "object",
      "required": [
        "role"
      ],
      "x-karvey-note": "wave3 §1.12 (REQ-W3-020): name defaults to the role; the destination target goes through safe_values.check_target (a secret's name for webhook, never a URL)",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "destination": {
          "type": "object",
          "required": [
            "channel"
          ],
          "properties": {
            "channel": {
              "enum": [
                "google-chat",
                "slack",
                "teams",
                "email",
                "webhook",
                "none",
                "google_chat"
              ]
            },
            "target": {
              "type": "string",
              "x-karvey-safe": "notifications.target"
            }
          }
        }
      }
    },
    "stakeholders": {
      "type": "object",
      "properties": {
        "sponsor": {
          "$ref": "#/$defs/stakeholder"
        },
        "approver": {
          "$ref": "#/$defs/stakeholder"
        },
        "executor": {
          "$ref": "#/$defs/stakeholder"
        }
      }
    }
  }
}
