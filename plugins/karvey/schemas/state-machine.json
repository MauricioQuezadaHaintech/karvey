{
  "$comment": "The phase graph as data (architecture §2.1, wave1-hardening). rules/state-machine.md renders it between generated markers; karvey-state.py reads it.",
  "version": 1,
  "phases": [
    {
      "id": "init",
      "approval": null,
      "skippable": false,
      "skill": "karvey-init",
      "produces": [
        "prd.md",
        "spec.json",
        "findings.md",
        "PLAN.md"
      ]
    },
    {
      "id": "requirements",
      "approval": "requirements",
      "skippable": false,
      "skill": "karvey-requirements",
      "gate": "what",
      "produces": [
        "requirements.md",
        "spec-delta.md"
      ],
      "reads": [
        "prd.md"
      ]
    },
    {
      "id": "mockup",
      "approval": "mockup",
      "skippable": true,
      "skill": "karvey-mockup",
      "gate": "what",
      "produces": [
        "mockup/"
      ],
      "reads": [
        "requirements.md",
        "prd.md"
      ]
    },
    {
      "id": "design_graphic",
      "approval": "design_graphic",
      "skippable": true,
      "skill": "karvey-design-graphic",
      "gate": "what",
      "produces": [
        "design-spec.md"
      ],
      "reads": [
        "mockup/",
        "requirements.md"
      ]
    },
    {
      "id": "architecture",
      "approval": "architecture",
      "skippable": false,
      "skill": "karvey-architecture",
      "gate": "how",
      "produces": [
        "architecture.md"
      ],
      "reads": [
        "requirements.md",
        "design-spec.md?"
      ]
    },
    {
      "id": "infra",
      "approval": "infra",
      "skippable": true,
      "skill": "karvey-infra",
      "gate": "how",
      "produces": [
        "infra.md"
      ],
      "reads": [
        "architecture.md"
      ]
    },
    {
      "id": "tasks",
      "approval": "tasks",
      "skippable": false,
      "skill": "karvey-tasks",
      "gate": "how",
      "produces": [
        "tasks.md"
      ],
      "reads": [
        "architecture.md",
        "requirements.md"
      ]
    },
    {
      "id": "impl",
      "approval": null,
      "skippable": false,
      "skill": "karvey-impl",
      "reads": [
        "tasks.md",
        "architecture.md"
      ]
    },
    {
      "id": "test",
      "approval": null,
      "skippable": false,
      "skill": "karvey-test",
      "reads": [
        "architecture.md",
        "requirements.md"
      ]
    },
    {
      "id": "qa",
      "approval": "qa",
      "skippable": false,
      "skill": "karvey-qa",
      "gate": "release",
      "produces": [
        "qa/REVISION_PR_*.md"
      ]
    },
    {
      "id": "deploying",
      "approval": null,
      "skippable": false,
      "skill": "karvey-deploy",
      "reads": [
        "qa/REVISION_PR_*.md"
      ]
    },
    {
      "id": "deployed",
      "approval": "prod",
      "skippable": false,
      "skill": "karvey-deploy",
      "gate": "release"
    },
    {
      "id": "archived",
      "approval": null,
      "skippable": false,
      "skill": "karvey-archive",
      "reads": [
        "spec-delta.md"
      ]
    }
  ],
  "edges": "forward: phases[i] -> phases[i+1]; a skipped phase is passed through",
  "reopen_targets": [
    "requirements",
    "architecture",
    "tasks",
    "impl"
  ],
  "preconditions": {
    "enter(P)": "every phase before P with a non-null approval is approved or skipped (a phase the change's lane marks s counts as skipped); deploying carries no approval: deploys are recorded in spec.json:deploys (deploy-record)",
    "enter(deployed)": "release ledger holds a human prod approval + pipeline run + post-deploy check; a clone without a ledger records it attested with --attested --ref D-NN --pipeline-run https://…",
    "enter(archived)": "phase = deployed AND spec.json approvals.prod.by set, role human, ref non-empty"
  }
}
