    {"id": "changes-in-flight", "since": "3.13.0", "title": "Report changes in flight whose gates are unmet",
     "check": "changes_in_flight_check", "fix": null, "dry_run": false, "human": false, "risk": "low",
     "report_only": true, "cost": "scan"}
  ]
}
