{
  "$comment": "The project-upgrade step catalogue (schema: schemas/upgrade-steps.schema.json). Order is the apply order. Functions live in upgrade_steps.REGISTRY; since is the release that added the step (fixed at release by karvey-deploy).",
  "catalogue_version": 1,
  "steps": [
    {"id": "schema-migrate", "since": "3.13.0", "title": "Migrate legacy spec.json / project.json shapes (exact tier)",
