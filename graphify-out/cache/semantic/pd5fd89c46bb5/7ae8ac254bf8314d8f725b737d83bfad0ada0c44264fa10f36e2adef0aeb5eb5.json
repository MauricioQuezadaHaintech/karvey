{"nodes": [{"id": "docs_spec_reviews_2026_09_23_judge_agents", "label": "Karvey 3.11.1 Review: Agent-Execution Judge (AG)", "file_type": "document", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Method content is strong but as an LLM-executed program it is fragile: determinism lives in prose; convert mechanical rules to scripts/hooks."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_01", "label": "AG-01: Deterministic state machine for spec.json (karvey-state.py)", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLM fuzzy-matches phase values differently each session; code-validated transitions remove the drift class."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_02", "label": "AG-02: Resolve contradictions forcing agent to break hard rules", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contradicting instructions make the LLM obey the nearest or stop to ask; happens every cycle."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_03", "label": "AG-03: Hooks must cover what the method calls 'never' (prod-gate)", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A skill guarantees nothing; a marker the agent can create itself controls nothing."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_04", "label": "AG-04: Per-phase context budget and progressive loading (_core.md)", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn cost grows with accumulated context; unused rules dilute attention (context rot)."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_05", "label": "AG-05: Remove graphify from every phase close", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilding the graph mid-phase is costly and unconsumed; an uncompliable mandatory step causes silent omission."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_06", "label": "AG-06: Remove rule copies and make paths resolvable", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unresolvable paths cost exploratory calls; copies lead the agent to stale versions."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_07", "label": "AG-07: ID allocation scripts (BUG-NN, D-NN, BL-NN, F-NN)", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counting and reserving is machine work; LLM fails precisely in multi-agent."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_08", "label": "AG-08: Fewer interruptions: one AskUserQuestion per gate, batched grill", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each interruption is a full-context turn; double questions add no control."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_09", "label": "AG-09: Fix session hook/handoff bugs, bound injection, capture state by script", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook-injected context is paid every turn; an LLM-transcribed measurement is not a measurement."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_10", "label": "AG-10: Release gate, dashboard, spec merge and health score as scripts", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsing/arithmetic fails intermittently and silently in LLMs; exit codes are the cheapest evidence."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_11", "label": "AG-11: Short frontmatter descriptions without generic/brand triggers", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skill selection depends solely on the description; truncated or competing descriptions misroute."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_12", "label": "AG-12: Independent verification of self-judgments (clean-context judge, evidence log)", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LLMs overrate their own work; a clean-context judge does not inherit the flawed reasoning."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_13", "label": "AG-13: Plugin CI linter to catch drift before release", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-file drift is invisible one skill at a time but visible to a whole-set script."}, {"id": "docs_spec_reviews_2026_09_23_judge_agents_ag_14", "label": "AG-14: Portability to other runtimes and teams", "file_type": "rationale", "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Method sold as stack/tool-agnostic; each hidden assumption is a step another team cannot run."}], "edges": [{"source": "docs_spec_reviews_2026_09_23_judge_agents", "target": "docs_spec_reviews_2026_09_23_judge_agents_ag_01", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_spec_reviews_2026_09_23_judge_agents_ag_01", "target": "plugins_karvey_skills_karvey_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_spec_reviews_2026_09_23_judge_agents_ag_01", "target": "plugins_karvey_skills_karvey_requirements_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_spec_reviews_2026_09_23_judge_agents_ag_01", "target": "plugins_karvey_skills_karvey_mockup_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/reviews/2026-09-23-judge-agents.md", "source_location": null, "weight": 1.0}, {"source": "docs_spec_reviews_2026_09_23_judge_agents_ag_01", "target": "plugins_karvey_skills_karvey_design_graphic_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/reviews