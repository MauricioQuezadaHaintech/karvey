{"nodes": [{"id": "changelog", "label": "CHANGELOG.md", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_release_3_11_1", "label": "Release 3.11.1 - karvey.html picks browser language, per-language tab title", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QA findings on REQ-ADP-031 and a Mac browser review."}, {"id": "changelog_release_3_11_0", "label": "Release 3.11.0 - visible version by environment + multilingual method page", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stuck pipeline variable once made a production front display an old version while running new code; DEV and PROD must show different things."}, {"id": "changelog_release_3_10_0", "label": "Release 3.10.0 - team settings on first use (team-adapters)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A graphify review showed the \"stack-agnostic\" plugin hard-coded one team's tooling (Google Chat via CLAUDE.md, ClickUp statuses); backlog BL-02/BL-03 promoted."}, {"id": "changelog_release_3_9_1", "label": "Release 3.9.1 - documentation drift fix", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts had drifted over releases, a README described hooks incorrectly and three phase skills read outdated rule copies (a silent behavior bug)."}, {"id": "changelog_release_3_9_0", "label": "Release 3.9.0 - branch hygiene, standards conformance in QA, PR gates", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merged branches piled up; no phase deleted anything after a merge. A gate never verified is not a gate. The method never checked the PR gates at the door of production."}, {"id": "changelog_release_3_8_0", "label": "Release 3.8.0 - agent handoff, optional team layer, verification rules, SessionStart hook", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 6-agent team run cost ~US$1,000 in 3 days and ended back on a single agent; teams kept as an option, never an obligation."}, {"id": "changelog_release_3_7_0", "label": "Release 3.7.0 - multi-agent and multi-repo work", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real project with four specialist agents in four repos had no place for what crossed agent/repo boundaries (audit D-47)."}, {"id": "changelog_release_3_6_0", "label": "Release 3.6.0 - causal discipline in karvey-investigate", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-mortem: a pre-existing fragility was reported as root cause while the real cause was a CSP header put in enforce six days earlier."}, {"id": "changelog_release_3_5_0", "label": "Release 3.5.0 - visual components catalog", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designers/illustration agents need an exhaustive per-component art brief; design-spec.md stops at token level."}, {"id": "changelog_release_3_4_0", "label": "Release 3.4.0 - AI-time estimation in minutes", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under AI-driven dev the effective cap is ~60 min; the legacy 6-hour rule assumed human time."}, {"id": "changelog_release_3_3_0", "label": "Release 3.3.0 - engineering standards layer", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The method specified what to build but had no canonical place for how to build it per layer; architecture/impl drifted on tribal knowledge."}, {"id": "changelog_release_3_2_0", "label": "Release 3.2.0 - iteration loop (Karvey becomes a spiral)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Karvey was a waterfall with a single QA micro-loop; spec defects had no edge back, ClickUp updates were skipped."}, {"id": "changelog_release_3_1_0", "label": "Release 3.1.0 - karvey-import", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Let teams already using Kiro or gstack adopt Karvey without rewriting specs."}, {"id": "changelog_release_3_0_0", "label": "Release 3.0.0 - initial publication as Claude Code plugin", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formalize Karvey as HainTech's own stack-agnostic method installable as a plugin."}, {"id": "changelog_causal_discipline", "label": "Causal discipline (date the symptom; what changed before what is wrong; causal-coherence gate)", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cause that predates the incident window cannot explain a symptom that started inside it: a pre-existing finding is latent fragility, not the cause."}, {"id": "changelog_pr_gates_verification", "label": "PR gates verification before prod OK", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never request the prod OK over a red or unresolved gate: that turns the human into a rubber stamp."}, {"id": "changelog_git_host_detection", "label": "Git host detection (gh pr / az repos pr / glab mr)", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deploy platform and the git host are different things; hardcoded gh failed on Azure Repos/GitLab."}, {"id": "changelog_standards_conformance_dimension", "label": "QA Dimension 9 - standards conformance (golden path)", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "karvey-impl required a Deviation Request but nothing verified it happened."}, {"id": "changelog_engineering_standards_layer", "label": "Engineering standards layer (golden paths, third source of truth)", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_deviation_request", "label": "Deviation Request + deviations.md", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_method_standards_two_planes", "label": "Method/standards separation (two 